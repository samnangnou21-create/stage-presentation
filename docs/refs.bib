@article{CALTAGIRONE2001607,
title = {Sur une méthode de pénalisation tensorielle pour la résolution des équations de Navier–Stokes},
journal = {Comptes Rendus de l'Académie des Sciences - Series IIB - Mechanics},
volume = {329},
number = {8},
pages = {607-613},
year = {2001},
issn = {1620-7742},
doi = {https://doi.org/10.1016/S1620-7742(01)01374-5},
url = {https://www.sciencedirect.com/science/article/pii/S1620774201013745},
author = {Jean-Paul Caltagirone and Stéphane Vincent},
keywords = {mécanique des fluides numerique, Navier–Stokes, méthode de pénalisation, tenseur des contraintes, simulation numérique directe, computational fluid mechanics, Navier–Stokes, penalisation method, stress tensor, direct numerical simulation},
abstract = {Résumé
Une reformulation originale du tenseur des contraintes est proposée pour les équations du mouvement d'un fluide incompressible. Cette décomposition fait apparaître quatre tenseurs différents, associés à des viscosités de compression, d'élongation, de cisaillement et de rotation. Le modèle proposé permet de construire une méthode de résolution des équations de Navier–Stokes basée sur une technique de pénalisation tensorielle généralisée à l'ensemble des contraintes qui agissent sur un écoulement. Le traitement de la contrainte d'incompressibilité et la rotation d'un solide non déformable dans un écoulement sont explicités à partir de ce modèle. Plusieurs applications numériques sont proposées pour illustrer les capacités de la nouvelle méthode de pénalisation.
An original reformulation of the viscous stress tensor is proposed for the motion equations dedicated to an incompressible fluid. Four different tensors appear in this decomposition, associated with viscosities of compression, elongation, shearing and rotation. This new model allows us to build a numerical solver of the Navier–Stokes equations based on a technique of tensorial penalization which is generalized with all the stresses acting on a flow. The processing of incompressibility and the rotation of a rigid body in a flow are described thanks to the model. Several numerical applications are proposed to illustrate the abilities of the new penalization method.}
}

